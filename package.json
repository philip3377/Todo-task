{
  "name": "taskflow-api",
  "version": "1.0.0",
  "description": "Beginner-friendly Task Management REST API for experimenting with GitLab CI/CD, dependency updates, and security scanning",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "audit": "npm audit --audit-level=high"
  },
  "keywords": [
    "express",
    "typescript",
    "rest-api",
    "gitlab-ci",
    "security"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  },
  "dependencies": {
    "express": "^4.21.2",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.23",
    "@types/node": "^22.16.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.14.0",
    "globals": "^16.3.0",
    "supertest": "^7.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
